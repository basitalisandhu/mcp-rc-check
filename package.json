{
  "name": "@basitalisandhu/mcp-rc-check",
  "version": "0.2.0",
  "description": "MCP specification migration checker: what an MCP server or client must change for the 2026-07-28 revision, with the spec section for each finding and a patch where the fix is mechanical; plus tool-surface pinning: lock the tools, schemas, annotations, prompts and resources a server exposes and report what changed before the next session.",
  "license": "MIT",
  "author": "Muhammad Basit Ali",
  "homepage": "https://github.com/basitalisandhu/mcp-rc-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basitalisandhu/mcp-rc-check.git"
  },
  "bugs": {
    "url": "https://github.com/basitalisandhu/mcp-rc-check/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-client",
    "specification",
    "migration",
    "linter",
    "compliance",
    "cli",
    "sarif",
    "developer-tools",
    "mcp-security",
    "pinning",
    "lockfile",
    "claude-code"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-rc-check": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
