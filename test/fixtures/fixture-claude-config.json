{
  "mcpServers": {
    "docs": {
      "type": "sse",
      "url": "https://mcp.example.invalid/sse"
    },
    "tickets": {
      "type": "http",
      "url": "https://tickets.example.invalid/mcp",
      "headers": {
        "Authorization": "Bearer ${TICKETS_TOKEN}",
        "MCP-Protocol-Version": "2025-06-18",
        "Mcp-Session-Id": "pinned-session",
        "Mcp-Method": "tools/call"
      }
    },
    "local": {
      "command": "npx",
      "args": [
        "-y",
        "example-mcp-server",
        "--protocol-version",
        "2025-03-26"
      ],
      "env": {
        "MCP_PROTOCOL_VERSION": "2024-11-05"
      }
    }
  }
}
